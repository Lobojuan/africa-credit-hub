[Unit]
Description=Universal Credit Hub
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=uch
Group=uch
WorkingDirectory=/opt/uch
EnvironmentFile=/etc/uch/production.env
Environment=NODE_ENV=production
Environment=PRODUCTION_MODE=true
ExecStart=/usr/bin/node dist/index.cjs
Restart=always
RestartSec=5
UMask=027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/uch/uploads /opt/uch/exports /opt/uch/backups

[Install]
WantedBy=multi-user.target
