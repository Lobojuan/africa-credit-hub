# Excluded from deployment image to stay under the 8 GiB limit.
# These directories are only needed for local development.

# Git history (5.1 GB) — not needed at runtime
.git/

# Playwright browser binaries (630 MB) — test-only, not needed in production
.cache/ms-playwright/

# TypeScript incremental build cache (14 MB)
.cache/typescript/

# Mockup sandbox — development canvas previews only
artifacts/

# Uploaded/attached dev assets — production copies are bundled into dist/public/assets/
attached_assets/

# Local agent state and skill files
.local/
.agents/
